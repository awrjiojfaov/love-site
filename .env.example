# ============================================================
# 秘密花园 love-site 配置样例
# ------------------------------------------------------------
# 用法：复制本文件为 `.env.local`，按注释填自己的值。
#   cp .env.example .env.local
# `.env.local` 已被 .gitignore 忽略，凭据不会进版本库。
# 所有变量都以 VITE_ 开头（Vite 只会把 VITE_ 前缀的变量注入前端）。
# 留空 = 使用代码内置的框架默认值（见 src/config.ts）。
# ============================================================

# ---------------- 站点信息 ----------------
VITE_APP_TITLE=秘密花园
VITE_APP_DESC=两个人共享的小天地
VITE_LOGIN_TITLE=我们的小窝
# ICP 备案号（中国大陆自建站才需要，留空则不显示）
VITE_ICP=

# ---------------- 默认账号组的两个人 ----------------
VITE_MEMBER_A=小雨
VITE_MEMBER_B=小晴
# 管理员（可停用/解封花园、创建账号组），默认等于 VITE_MEMBER_B
VITE_ADMIN_NAME=小晴
VITE_MEMBER_A_PASSWORD=0000
VITE_MEMBER_B_PASSWORD=0000
# 管理员密码，默认等于 VITE_MEMBER_B_PASSWORD
VITE_ADMIN_PASSWORD=

# ---------------- 数据同步（MQTT） ----------------
# 数据空间主题前缀。不同部署要用不同的值，否则公共 broker 上会互相看到数据。
# 建议用一段只有你知道的随机串，例如 lovesite-<8位随机>/
VITE_TOPIC_PREFIX=lovesite/

# 自建 MQTT broker（可选，强烈建议；不填就只用公共 broker，数据不受你控制）
# 形如：wss://mqtt.yourdomain.com/mqtt
VITE_MQTT_PRIMARY_URL=
VITE_MQTT_PRIMARY_USER=
VITE_MQTT_PRIMARY_PASS=

# ---------------- 纪念日 ----------------
# 在一起的起始时刻（ISO 格式）。留空 = 由双方在页面上自设，纪念日盲盒停用。
VITE_LOVE_START=

# ---------------- 爱情树历史保底（一般留空） ----------------
# 默认空间贡献账本永久下限，JSON 对象。仅在历史数据被清空后找回时使用。
VITE_TREE_FLOOR=
